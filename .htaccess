Options +Indexes
DirectoryIndex index.html preview.html

<FilesMatch "\.(html|htm|css|js|jpg|jpeg|png|gif|ico|pdf|svg)$">
  Order Allow,Deny
  Allow from all
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Force HTTPS (uncomment if needed)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
