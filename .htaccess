Options +Indexes
DirectoryIndex preview.html index.html

<FilesMatch "\.(html|htm|css|js|jpg|jpeg|png|gif|ico|pdf|svg)$">
  Order Allow,Deny
  Allow from all
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Rewrite requests for non-existing files to preview.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ preview.html [L]
</IfModule>

# PHP settings
php_value memory_limit 256M
php_value post_max_size 64M
php_value upload_max_filesize 64M
php_value max_execution_time 300
